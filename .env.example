# SQLite by default; point elsewhere if you outgrow it.
DATABASE_URL=sqlite:///./data/devicemanager.db

# Your existing ntfy topic URL, e.g. https://ntfy.sh/my-private-topic-name
NTFY_URL=
NTFY_DEFAULT_PRIORITY=default

# Login credentials for the web dashboard.
ADMIN_USERNAME=admin

# IMPORTANT if you run this via `docker compose`: Compose applies ${VAR}
# interpolation to env_file values, so a literal "$" in your password gets
# silently eaten - e.g. ADMIN_PASSWORD=p@ss$Kword becomes just "p@ss" with a
# "the K variable is not set" warning on `docker compose up`, and you'll never
# be able to log in with the password you actually meant. Either:
#   1. avoid "$" in your password, or
#   2. escape it as "$$" (p@ss$$Kword), or
#   3. skip this var entirely and use ADMIN_PASSWORD_FILE below instead -
#      Compose never parses the *contents* of a mounted file, so this has
#      no such gotcha regardless of what characters your password uses.
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Sign in with OpenID Connect (authentik). In authentik: Applications > Providers >
# create an OAuth2/OpenID provider (confidential client), redirect URI
# https://<your dashboard>/login/oidc/callback, then copy its "OpenID
# Configuration Issuer" URL and the client id/secret here. Users are created on
# their first sign-in; OIDC_ALLOWED_GROUP limits who may sign in.
# OIDC_ISSUER=https://auth.example.com/application/o/devicemanager/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=authentik
# OIDC_AUTO_CREATE=true
# OIDC_ALLOWED_GROUP=
# The dashboard's address as browsers see it (needed behind a proxy for the redirect URI).
# PUBLIC_URL=https://dm.example.com
# Hide the username/password form once OIDC works (ADMIN_* then can't sign in).
# PASSWORD_LOGIN=true

# Session cookie signing key: leave unset. It's auto-generated on first run
# and persisted to data/session_secret.key, so there's nothing to configure
# here - only set SESSION_SECRET yourself if multiple host instances need to
# share one value (e.g. behind a load balancer).
SESSION_SECRET=

# Set true only if you reach the dashboard over https:// (TLS proxy in front).
# Leave false for plain http://host:8000 - a Secure cookie is dropped over
# HTTP and login will loop back to the login page.
SESSION_HTTPS_ONLY=false

# How often (seconds) the host scans for devices that stopped reporting.
CHECK_INTERVAL_SECONDS=15

# How long (days) to keep per-report cpu/mem/disk history for the sparkline charts.
HISTORY_RETENTION_DAYS=7

# Keep hourly averages this long (days) for the 30d / 90d / 1y charts.
LONG_HISTORY_DAYS=400

# Re-push unacknowledged high problems every N hours (0 = off).
REMINDER_HOURS=8

# Watchdog: a URL Pulse calls while it's healthy (e.g. https://hc-ping.com/<uuid>),
# so something outside the lab tells you when Pulse, its machine or ntfy stops.
# WATCHDOG_URL=

# SSH alerts: failed logins in one report window (0 = off), and logins from
# outside private / Tailscale / loopback addresses.
SSH_FAILED_ALERT=20
SSH_OUTSIDE_LOGIN_ALERT=true

# PBS checks: a guest's newest backup is late after this many hours.
PBS_BACKUP_MAX_AGE_HOURS=26

# Bearer token for /metrics (Prometheus) and /api/v1/summary (Homepage). Empty = off.
# METRICS_TOKEN=

# Read-only status page at /status/public, outside the login.
PUBLIC_STATUS=false
