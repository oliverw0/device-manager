# SQLite by default; point elsewhere if you outgrow it.
DATABASE_URL=sqlite:///./data/devicemanager.db

# Your existing ntfy topic URL, e.g. https://ntfy.sh/my-private-topic-name
NTFY_URL=
NTFY_DEFAULT_PRIORITY=default

# Login credentials for the web dashboard. Any characters are fine (the app
# strips wrapping quotes/whitespace defensively), but if you run the host via
# `docker compose` note that Compose's env_file does NOT strip quotes the way
# a plain .env loaded by this app does - so if you wrap the value in quotes
# here, that's fine either way, just don't mix "quoted in one place, bare in
# another" when copying the password elsewhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs the login session cookie. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-too

# How often (seconds) the host scans for devices that stopped reporting.
CHECK_INTERVAL_SECONDS=15

# How long (days) to keep per-report cpu/mem/disk history for the sparkline charts.
HISTORY_RETENTION_DAYS=7
